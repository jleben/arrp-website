arg_max(x) = index[#x-1] where
{
    value[0]  = x[0];
    index[0]  = 0;
    value[i]  = if is_max[i] then x[i] else value[i-1]  for i < #x;
    index[i]  = if is_max[i] then i    else index[i-1]  for i < #x;
    is_max[i] = x[i] > value[i-1]                       for i < #x;
};

main = arg_max([3;0;5;9;4;2]);
