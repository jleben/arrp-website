extends ../doc-page.template.pug

block doc-content

  h1
    a(href=doc_path + '/library') Arrp Core Library
    | : envelope

  h2 asr(trigger, dur_atk, dur_rls)

  p.
    An attack-sustain-release envelope.
    
    While the boolean trigger signal is true, the output signal moves towards 1 at the
    rate 1/dur_atk and then stays at 1.
    While the trigger is false, the output signal moves towards 0 at the rate
    1/dur_rls and then stays at 0.
    
  h2 ad(trigger, dur_atk, dur_dcy)

  p.
    An attack-decay envelope.
    
    When the boolean trigger signal is true, the output signal resets to 0.
